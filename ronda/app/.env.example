# Copier en .env.production (ou définir ces variables dans la CI) avant `npm run build`.

# Adresse WebSocket du serveur de jeu, OBLIGATOIRE pour les applications Android/iOS.
# (La version web servie par le serveur lui-même n'en a pas besoin.)
VITE_SERVER_URL=wss://ronda-dyalna.onrender.com/ws

# Google AdMob — blocs d'annonces (sans valeur : blocs de TEST de Google).
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_IOS_INTERSTITIAL=

# RevenueCat — clés publiques des SDK (sans valeur : achats désactivés).
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
